# Copy to .env and set unique values before running.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
# Leave unset for a local SQLite database. Example MySQL:
# DATABASE_URL=mysql+pymysql://threat_app:password@localhost:3306/threat_detector?charset=utf8mb4
# Set to 1 behind HTTPS in production.
COOKIE_SECURE=0
# Optional private data locations (default: instance/uploads and instance/models)
# UPLOAD_DIR=C:/private/threat-detector/uploads
# MODEL_DIR=C:/private/threat-detector/models
